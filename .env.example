# Evently — copie para .env.local (ignorado pelo Git)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=preencha-a-chave-publica
# Privada, somente no servidor
SUPABASE_SERVICE_ROLE_KEY=preencha-a-service-role
# Origem absoluta: HTTPS em homologação/produção; sem caminho ou barra adicional
APP_URL=http://localhost:3100

# Remetente padrão de testes Resend; destinatários limitados pela conta
EMAIL_TRANSPORT=resend
RESEND_API_KEY=preencha-no-ambiente
EMAIL_FROM=Evently <onboarding@resend.dev>
# Segredo aleatório com no mínimo 32 caracteres; somente worker/servidor
NOTIFICATION_WORKER_TOKEN=gere-um-segredo-aleatorio-com-32-ou-mais-caracteres

# Homologação LOCAL: troque EMAIL_TRANSPORT para local e habilite estes valores
# EMAIL_LOCAL_URL=http://127.0.0.1:55434
# ALLOW_LOCAL_EMAIL=true
