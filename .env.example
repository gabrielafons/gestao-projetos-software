# =============================================================================
# Evently - variaveis de ambiente
# Copie este arquivo para `.env.local` e preencha com as chaves do projeto.
# `.env.local` NAO vai para o Git.
#
# Onde encontrar: painel do Supabase > Project Settings > API
# =============================================================================

# URL do projeto Supabase (publica, exposta ao navegador).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Chave anonima (publica). Respeita as policies de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Chave de servico (PRIVADA - nunca exponha no navegador).
# Ignora RLS; usada apenas no servidor, para criar o usuario no Auth e
# gravar o perfil na mesma operacao de cadastro.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
